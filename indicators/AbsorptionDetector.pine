//@version=5
indicator("Absorption Detector", shorttitle="AbsDetect", overlay=true)

// =============================================================================
// INPUTS
// =============================================================================

// Volume Settings
volumeSpikeMultiplier = input.float(3.0, title="Volume Spike Multiplier", minval=1.0, step=0.1,
    tooltip="Volume must exceed average by this multiple to be considered a spike")
volumeSmaLength = input.int(20, title="Volume SMA Length", minval=1,
    tooltip="Period for calculating average volume")

// Price Settings
priceChangeThreshold = input.float(0.2, title="Price Change Threshold (%)", minval=0.01, step=0.01,
    tooltip="Maximum body size as percentage of open price to be considered flat")

// Buy Pressure Settings
buyPressureRatio = input.float(1.5, title="Buy Pressure Ratio", minval=1.0, step=0.1,
    tooltip="Buy volume must exceed sell volume by this ratio for buy-side absorption")

// Display Settings
showSignals = input.bool(true, title="Show Signals",
    tooltip="Toggle visibility of absorption signals on chart")
alertEnabled = input.bool(false, title="Alert Enabled",
    tooltip="Enable alert notifications for absorption signals")

// =============================================================================
// CALCULATIONS
// =============================================================================

// 4.1 Volume Spike Detection
volAvg = ta.sma(volume, volumeSmaLength)
volSpike = volume > volAvg * volumeSpikeMultiplier

// 4.2 Price Flat Detection (horizontal price movement)
priceChangePct = math.abs(close - open) / open * 100
priceFlat = priceChangePct < priceChangeThreshold

// 4.3 Buy Flow Dominance Detection
// Using price position within bar to estimate buy/sell volume
// Buy volume: portion of volume attributed to buying pressure (close near high = more buying)
// Sell volume: portion of volume attributed to selling pressure (close near low = more selling)
barRange = high - low + 1e-6  // Add small value to prevent division by zero
buyVol = volume * ((close - low) / barRange)
sellVol = volume - buyVol
buyDominant = buyVol > sellVol * buyPressureRatio

// 4.4 Absorption Signal - All conditions must be met
// Skip bars with zero volume
validBar = volume > 0
absorption = volSpike and priceFlat and buyDominant and validBar

// =============================================================================
// OUTPUTS
// =============================================================================

// 5.1 Signal Visualization
plotshape(showSignals and absorption,
    title="Absorption Signal",
    style=shape.triangleup,
    location=location.belowbar,
    color=color.green,
    size=size.small,
    text="Abs")

// 5.2 Alert Condition
alertcondition(alertEnabled and absorption,
    title="Absorption Detected",
    message="Absorption Signal Detected - Volume spike with flat price and buy-side dominance")

// =============================================================================
// DEBUG / INFO PANEL (optional - can be enabled for analysis)
// =============================================================================

// Background highlight for absorption bars (subtle visual cue)
bgcolor(absorption ? color.new(color.green, 90) : na, title="Absorption Background")

// Plot volume ratio for reference (in separate pane if needed)
// Uncomment below lines to see volume analysis in a separate indicator pane
// plot(volume / volAvg, title="Volume Ratio", color=color.blue)
